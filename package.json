{
    "name": "rarebert-cli",
    "version": "1.0.0",
    "type": "module",
    "bin": {
        "rarebert": "./index.js"
    },
    "scripts": {
        "list": "node index.js",
        "reload": "node index.js reload",
        "memo": "node index.js memo",
        "forgetMemo": "FORGET=true node index.js memo",
        "format": "prettier --write lib/ scripts/ index.js *.json *.md",
        "format:check": "prettier --check lib/ scripts/ index.js *.json *.md"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "enquirer": "^2.4.1",
        "opencode-ai": "^1.18.12"
    },
    "devDependencies": {
        "prettier": "^3.9.6"
    }
}
