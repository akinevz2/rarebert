{
    "name": "rarebert-cli",
    "version": "1.0.0",
    "type": "module",
    "bin": {
        "rarebert": "./index.js"
    },
    "scripts": {
        "list": "node index.js",
        "memo": "node index.js memo",
        "reload": "node index.js reload",
        "server": "tsx index.js server",
        "opencode": "npx opencode-ai@latest",
        "format": "prettier --write lib/ scripts/ src/**/*.ts index.js *.json *.md",
        "format:check": "prettier --check lib/ scripts/ src/**/*.ts index.js *.json *.md",
        "build": "tsc",
        "check": "tsc --noEmit"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "enquirer": "^2.4.1",
        "opencode-ai": "^1.18.12"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^5.0.0"
    }
}
