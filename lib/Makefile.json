{
    "lines": {
        "blank": "",
        "header_comment": "# Auto-generated Makefile",
        "echo_created": "\t  echo \"Created: $$file\"; \\",
        "open_editor_last": "\t  $${EDITOR:-nano} $$EDITOR_FLAGS \"$$file\"",
        "open_editor_last_cont": "\t  $${EDITOR:-nano} $$EDITOR_FLAGS \"$$file\"; \\",
        "load_last_module": "\t@file=$$(cat .last-module); \\",
        "load_last_module_indented": "\t  file=$$(cat .last-module); \\",
        "guard_last_module_exists": "\t  [ -f .last-module ] || exit 1; \\",
        "run_index": "\tnode index.js",
        "run_reload": "\tnode index.js reload",
        "run_add": "\t@node index.js add; \\",
        "guard_run_add_first": "\t  [ -n \"$$file\" ] || { echo 'Run make add first'; exit 1; }; \\",
        "opencode_implement": "\t  opencode run \"Implement the module in $$file\" --auto -m ollama/glm-5.2:cloud",
        "clean_last_module": "\t  @if [ -n \"$$FORGET\" ]; then rm -f .last-module; fi"
    },
    "recipes": {
