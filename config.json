{
    "_doc": "Centralised configuration for the rarebert pipeline. Each section maps to a module concern; tweak values here rather than touching the Python source. The keys prefixed with underscore are ignored by the loader and only exist for documentation.",
    "paths": {
        "tsv_dir": "propaganda_dataset_v2",
        "train_dataset": "propaganda_dataset_v2/propaganda_train.tsv",
        "val_dataset": "propaganda_dataset_v2/propaganda_val.tsv",
        "db_filename": "rarebert.db",
        "local_deps_dirname": ".rarebert_deps",
        "viewer_public_dir": "nlp-pipeline-viewer/public",
        "makefile": "Makefile",
        "library_module": "devlib.py"
    },
    "schema": {
        "pipeline_top_keys": [
            "stages",
            "metadata"
        ],
        "stage_keys": [
            "module",
            "runtime",
            "printout",
            "args",
            "output",
            "stderr",
            "returncode",
            "status"
        ],
        "metadata_keys": [
            "version",
            "created_at",
            "description"
        ],
        "metadata_version": "1.0",
        "metadata_description": "Generated by join-stages.py after running the chained makefile pipeline."
    },
    "data_loader": {
        "required_columns": [
            "label",
            "tagged_in_context"
        ],
        "default_label": "not_propaganda",
        "tsv_delimiter": "\t",
        "env_var_training": "TRAINING",
        "color_scheme": {
            "not_propaganda": "RESET",
            "flag_waving": "RED",
            "loaded_language": "GREEN",
            "name_calling": "YELLOW",
            "doubt": "BLUE",
            "appeal_to_fear_prejudice": "MAGENTA",
            "causal_oversimplification": "CYAN",
            "repetition": "LIGHT_RED",
            "exaggeration": "LIGHT_GREEN",
            "minimisation": "LIGHT_YELLOW"
        },
        "ansi": {
            "RESET": "\u001b[0m",
            "RED": "\u001b[31m",
            "GREEN": "\u001b[32m",
            "YELLOW": "\u001b[33m",
            "BLUE": "\u001b[34m",
            "MAGENTA": "\u001b[35m",
            "CYAN": "\u001b[36m",
            "LIGHT_RED": "\u001b[91m",
            "LIGHT_GREEN": "\u001b[92m",
            "LIGHT_YELLOW": "\u001b[93m"
        }
    },
    "training_set": {
        "default_classification": "not_propaganda",
        "header_keywords": [
            "label",
            "class",
            "classification"
        ],
        "span_marker_open": "<BOS>",
        "span_marker_close": "<EOS>",
        "tsv_delimiter": "\t",
        "json_indent": 2,
        "env_arg_prefix": "FILE="
    },
    "enrich_bow": {
        "default_classification": "not_propaganda",
        "token_pattern": "\\b[a-zA-Z0-9]+(?:'[a-zA-Z0-9]+)?\\b",
        "json_indent": 2,
        "output_separator": "[]"
    },
    "top_max": {
        "default_n": 5,
        "env_var_n": "ITEMS",
        "json_indent": 2
    },
    "bottom_max": {
        "default_n": 5,
        "env_var_n": "ITEMS",
        "json_indent": 2
    },
    "runtime": {
        "runtimes": {
            "make": "make {module}",
            "java": "java -cp target/classes com.example.{module}",
            "default": "{module}"
        }
    },
    "join_stages": {
        "stages_key": "stages",
        "metadata_key": "metadata",
        "created_at_format": "%Y-%m-%d",
        "viewer_dir_env_var": "PIPELINE_VIEWER_DIR",
        "non_stage_targets": [
            "join-stages",
            "bootstrap-make",
            "devlib",
            "runtime"
        ]
    },
    "bootstrap_make": {
        "header": "# Auto-generated by bootstrap-make.py. Edit bootstrap-make.py, then regenerate.",
        "python_var": "PYTHON ?= python3",
        "help_target_count": 8,
        "max_module_name_length": 15,
        "module_name_pattern": "[A-Za-z_][A-Za-z0-9_-]*",
        "ignored_module_prefix": ".",
        "join_stages_filter": "join-stages"
    },
    "ollama": {
        "default_port": 11434,
        "request_timeout": 3.0,
        "endpoint_path": "/api/tags",
        "scheme": "http",
        "max_hostname_display_models": 3,
        "namespaces": {
            "available": "available_hosts",
            "usable": "usable_hosts",
            "aliases": "ollama_host_aliases"
        },
        "skip_enrichment_label": "(skip enrichment)"
    },
    "kv_store": {
        "table_name": "kv_store",
        "schema_sql": "CREATE TABLE IF NOT EXISTS kv_store (namespace TEXT NOT NULL, key TEXT NOT NULL, value_json TEXT NOT NULL, updated_at TEXT NOT NULL DEFAULT (datetime('now')), PRIMARY KEY (namespace, key))",
        "namespace_min_length": 1,
        "key_min_length": 1
    },
    "rest_server": {
        "host": "0.0.0.0",
        "port": 8338,
        "make_timeout_seconds": 300,
        "shutdown_grace_seconds": 0.1,
        "post_path": "/",
        "field_make_target": "make_target",
        "status_ok": "success",
        "output_field": "output"
    },
    "environment": {
        "_doc": "Reserved env-var names. Modules should look these up rather than hardcoding strings."
    }
}