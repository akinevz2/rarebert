{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "none",
    "printWidth": 100,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.md",
            "options": { "proseWrap": "preserve" }
        },
        {
            "files": "*.json",
            "options": { "tabWidth": 4 }
        },
        {
            "files": "*.svg",
            "options": { "parser": "html" }
        }
    ]
}
