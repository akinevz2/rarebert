# ─────────────────────────────────────────────────────────────────────────────
# Rarebert venv: an accidental Python virtualenv was created inside this
# project root (the bin/, lib/, include/, etc. directories).  Ignore those
# specifically rather than blanket-ignoring everything in the repo.
# ─────────────────────────────────────────────────────────────────────────────

# Standard venv layout, present at the project root.
bin/
etc/
include/
lib/
lib64
local/
share/
__pycache__/
pyvenv.cfg

# Common Python build artefacts.
*.egg-info/
*.pyc
*.pyo
*.pyd

# Editor / tooling caches.
.agents/
.claude/
.metals/
.bsp/
.bloop/
.scala-build/
.vscode/

# ─────────────────────────────────────────────────────────────────────────────
# Per-directory tooling ignores (kept terse; nothing else is blanket-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# nlp-pipeline-viewer has its own node_modules and build output.
nlp-pipeline-viewer/node_modules/
nlp-pipeline-viewer/dist/

# Scala sbt output.
target/
src/scala/target/
src/scala/project/target/
src/scala/project/project/

# Maven output.
src/java/target/

# Generic OS noise.
.DS_Store

# Generated files
*.class
*.jar
*.war
*.ear
*.log
*.tmp
*.pid
*.lock

# Build artifacts
build/
dist/
out/
*.out

# Rarebert runtime artefacts.
.rarebert_logs/

# IDE specific files
*~
.*.swp
.*.swo
Thumbs.db
