# Modelfile for Rarebert Library Refactor
# Inherit from laguna-xs-2.1:latest
# TEMPLATE, RENDERER, and PARSER are inherited from the base model.
# We only need to override SYSTEM prompt and PARAMETERS for refactoring work.
#
# Create/overwrite the model with:
#   OLLAMA_HOST=http://ws-rarebox:11434 ollama create RAREBERT -f Modelfile.refactor

FROM laguna-xs-2.1:q8_0

TEMPLATE {{ .Prompt }}
RENDERER poolside-v1
PARSER poolside-v1

PARAMETER temperature 1